[Unit]
Description=Stock V4 private OCTOP RPC listener
ConditionPathIsDirectory=/opt/1panel/apps/local/stock-system/runtime/octop-rpc

[Socket]
ListenStream=/opt/1panel/apps/local/stock-system/runtime/octop-rpc/bridge.sock
SocketUser=root
SocketMode=0660
ExecStartPost=/usr/bin/chgrp 10001 /opt/1panel/apps/local/stock-system/runtime/octop-rpc/bridge.sock
Accept=yes
MaxConnections=2
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
