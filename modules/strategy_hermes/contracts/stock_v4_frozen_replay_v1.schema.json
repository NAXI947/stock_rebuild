{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockapp.invalid/schemas/stock-v4-frozen-replay-v1",
  "type": "object",
  "required": [
    "schema",
    "input_kind",
    "namespace",
    "calendar",
    "instruments",
    "events"
  ],
  "properties": {
    "schema": {
      "const": "stock-v4-frozen-replay-v1"
    },
    "input_kind": {
      "const": "FROZEN"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
    },
    "calendar": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "date"
      }
    },
    "instruments": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[0-9]{6}\\.(SH|SZ)$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "rules": {
      "type": "object"
    },
    "events": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/report"
          },
          {
            "$ref": "#/$defs/quote"
          }
        ]
      }
    }
  },
  "$defs": {
    "report": {
      "type": "object",
      "required": [
        "kind",
        "report_json"
      ],
      "properties": {
        "kind": {
          "const": "report"
        },
        "report_json": {
          "type": "string",
          "minLength": 1
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "judgments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sector_id",
              "phase",
              "evidence_ref"
            ],
            "properties": {
              "sector_id": {
                "type": "string",
                "pattern": "^kaipanla:[0-9A-Za-z_-]{1,64}$"
              },
              "phase": {
                "const": "RETREAT"
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "etf",
              "sector_id",
              "rank",
              "mapping_ref"
            ],
            "properties": {
              "etf": {
                "type": "string",
                "pattern": "^[0-9]{6}\\.(SH|SZ)$"
              },
              "sector_id": {
                "type": "string",
                "pattern": "^kaipanla:[0-9A-Za-z_-]{1,64}$"
              },
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "mapping_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "quote": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "etf",
        "observed_at",
        "source",
        "tradeable"
      ],
      "oneOf": [
        {
          "required": [
            "price_cny"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "price"
                ]
              },
              {
                "required": [
                  "price_unit"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "price",
            "price_unit"
          ],
          "not": {
            "required": [
              "price_cny"
            ]
          }
        }
      ],
      "properties": {
        "kind": {
          "const": "quote"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "etf": {
          "type": "string",
          "pattern": "^[0-9]{6}\\.(SH|SZ)$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "tradeable": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "price_cny": {
          "type": [
            "string",
            "integer"
          ]
        },
        "price": {
          "type": [
            "string",
            "integer"
          ]
        },
        "price_unit": {
          "enum": [
            "CNY",
            "FEN"
          ]
        }
      }
    }
  }
}
